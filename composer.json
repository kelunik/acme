{
    "name": "kelunik/acme",
    "description": "ACME library written in PHP.",
    "license": "MIT",
    "authors": [
        {
            "name": "Niklas Keller",
            "email": "me@kelunik.com"
        }
    ],
    "keywords": [
        "ACME",
        "letsencrypt",
        "certificate",
        "https",
        "encryption",
        "ssl",
        "tls"
    ],
    "autoload": {
        "psr-4": {
            "Kelunik\\Acme\\": "src"
        },
        "files": [
            "src/functions.php",
            "src/Protocol/functions.php"
        ]
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.1",
        "ext-openssl": "*",
        "amphp/amp": "^3.1.0",
        "amphp/byte-stream": "^2.1.2",
        "amphp/dns": "^2.4.0",
        "amphp/file": "^3.2.0",
        "amphp/http-client": "^5.3.3",
        "amphp/socket": "^2.3.1",
        "league/uri": "^7.5.1",
        "psr/log": "^1 || ^2 || ^3",
        "psr/http-message": "^2.0",
        "kelunik/certificate": "^1.1.3",
        "beberlei/assert": "^3.3.3",
        "symfony/polyfill-php83": "^1.32.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6.23",
        "amphp/phpunit-util": "^3",
        "amphp/php-cs-fixer-config": "^2.1.0",
        "psalm/phar": "~6.13"
    }
}
